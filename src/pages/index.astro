<script>
	// 纯前端动态更新日期，打造视觉保鲜效果 (100% SEO 安全)
	document.addEventListener('DOMContentLoaded', () => {
		const today = new Date();
		
		const formatDate = (date) => {
			return `${date.getMonth() + 1}月${date.getDate()}日`;
		};
		
		const yesterday = new Date(today);
		yesterday.setDate(yesterday.getDate() - 1);
		
		const dayBefore = new Date(today);
		dayBefore.setDate(dayBefore.getDate() - 2);

		// 1. 更新 Hero 区域徽章
		const heroDateEl = document.getElementById('hero-date');
		if (heroDateEl) {
			heroDateEl.textContent = `全站数据已于 ${formatDate(today)} 最新实测`;
		}

		// 2. 更新跑马灯日期 (制造极高活跃度假象)
		document.querySelectorAll('.dynamic-date-0').forEach(el => el.textContent = formatDate(today) + "：");
		document.querySelectorAll('.dynamic-date-1').forEach(el => el.textContent = formatDate(yesterday) + "：");
		document.querySelectorAll('.dynamic-date-2').forEach(el => el.textContent = formatDate(dayBefore) + "：");
	});
</script>

