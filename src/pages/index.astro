							<div class="absolute -right-6 -top-6 h-32 w-32 rounded-full bg-gradient-to-br from-amber-50 to-amber-100/50 transition-transform duration-500 group-hover:scale-150"></div>
							<div class="relative z-10 flex items-start justify-between">
								<div>
