---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const tutorials = await getCollection('tutorial');
---

<Layout 
	title="老叶保姆级教程：小白科学上网必备指南 - 机场点击"
	description="机场点击提供最通俗易懂的 Clash、Shadowrocket 节点导入教程。跟着老叶学配置，避开所有新手坑。"
>
	<main class="flex-1 bg-slate-50 py-12 sm:py-20 min-h-screen">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			
			<div class="mb-12">
				<h1 class="text-3xl font-extrabold text-slate-900 sm:text-4xl tracking-tight">
					📚 老叶的干货库 (教程与实测)
				</h1>
				<p class="mt-4 text-lg text-slate-600">从保姆级的小白防坑教程，到真实的机场晚高峰测速报告，老叶全给你安排明白了。</p>
			</div>

			<div class="grid gap-6">
				{tutorials.map((tutorial) => (
					<a href={`/tutorial/${tutorial.id}/`} class="group relative flex flex-col md:flex-row items-center justify-between gap-6 rounded-3xl bg-white p-6 shadow-xl shadow-slate-200/50 ring-1 ring-slate-900/5 transition-all hover:-translate-y-1 hover:shadow-2xl hover:shadow-blue-200/50">
						<div class="flex-1">
							<div class="flex items-center gap-3 mb-3">
								<span class="inline-flex items-center rounded-full bg-blue-50 px-2 py-1 text-xs font-semibold text-blue-700 ring-1 ring-inset ring-blue-600/20">
									作者：{tutorial.data.author}
								</span>
								<time class="text-xs text-slate-500">
									{new Date(tutorial.data.date).toLocaleDateString('zh-CN')}
								</time>
							</div>
							<h2 class="text-xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
								{tutorial.data.title}
							</h2>
							<p class="mt-3 text-sm text-slate-500 line-clamp-2">
								{tutorial.data.description}
							</p>
						</div>
						
						<div class="hidden md:flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-slate-50 text-slate-400 group-hover:bg-blue-600 group-hover:text-white transition-all">
							<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
							</svg>
						</div>
					</a>
				))}
			</div>

		</div>
	</main>
</Layout>
