---
import Layout from '../../layouts/Layout.astro';
import AffiliateCTA from '../../components/AffiliateCTA.astro';

const softwareSchema = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	"name": "Shadowrocket",
	"operatingSystem": "iOS",
	"applicationCategory": "UtilitiesApplication",
	"offers": {
		"@type": "Offer",
		"price": "2.99",
		"priceCurrency": "USD"
	}
};
---

<Layout 
	title="Shadowrocket (小火箭) 官方正版下载指南 - iOS 翻墙必备"
	description="苹果手机怎么下载小火箭？老叶教你零成本获取美区 Apple ID，安全下载正版 Shadowrocket，并推荐兼容性最好的优质机场节点。"
	keywords="Shadowrocket下载, 小火箭下载, 苹果小火箭, 小火箭免费账号, iOS翻墙软件"
	customSchema={softwareSchema}
>
	<main class="flex-1 bg-slate-50 pb-24">
		<!-- Hero Section -->
		<section class="bg-white border-b border-slate-200 py-12">
			<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex items-center gap-2 mb-4">
					<a href="/downloads" class="text-sm font-semibold text-emerald-600 hover:text-emerald-500">&larr; 返回下载中心</a>
