				<div class="flex flex-col sm:flex-row gap-4 my-8">
					<a href="https://github.com/2dust/v2rayN/releases/latest/download/v2rayN-Core.zip" target="_blank" rel="nofollow" class="flex-1 text-center bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-4 px-6 rounded-xl transition-all hover:-translate-y-1 shadow-lg shadow-emerald-600/30 no-underline">
