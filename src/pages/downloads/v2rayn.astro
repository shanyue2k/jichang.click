---
import Layout from '../../layouts/Layout.astro';
import AffiliateCTA from '../../components/AffiliateCTA.astro';

const softwareSchema = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	"name": "v2rayN",
	"operatingSystem": "Windows",
	"applicationCategory": "UtilitiesApplication",
	"offers": {
		"@type": "Offer",
		"price": "0",
		"priceCurrency": "CNY"
	}
};
---

<Layout 
	title="v2rayN 官方纯净版免费下载 (2026 最新) - Windows 防木马指北"
	description="拒绝百度搜索流氓弹窗！老叶为您提供 v2rayN 官方 GitHub 原版的安全下载链接，包含 Core 内核。老牌稳定极简代理客户端。"
	keywords="v2rayN下载, v2rayN官方下载, Windows翻墙客户端, v2ray最新版"
	customSchema={softwareSchema}
>
	<main class="flex-1 bg-slate-50 pb-24">
		<!-- Hero Section -->
		<section class="bg-white border-b border-slate-200 py-12">
			<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex items-center gap-2 mb-4">
					<a href="/downloads" class="text-sm font-semibold text-emerald-600 hover:text-emerald-500">&larr; 返回下载中心</a>
					<span class="text-slate-300">|</span>
					<span class="text-sm font-semibold text-slate-500">Windows 端</span>
				</div>
				<h1 class="text-3xl font-extrabold text-slate-900 sm:text-4xl leading-tight">
					v2rayN 官方正版下载 (含内核)
				</h1>
				<div class="mt-4 flex flex-wrap items-center gap-2 text-sm">
					<span class="bg-purple-100 text-purple-700 px-3 py-1 rounded-full font-bold">老牌极简神器</span>
					<span class="bg-slate-100 text-slate-600 px-3 py-1 rounded-full font-medium">安全级别: 极高 (开源)</span>
					<span class="bg-emerald-100 text-emerald-700 px-3 py-1 rounded-full font-medium">支持 Windows 10/11</span>
				</div>
			</div>
		</section>

		<!-- Content Section -->
		<section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
			<article class="prose prose-slate prose-emerald lg:prose-lg max-w-none">
				
				<div class="bg-rose-50 border-l-4 border-rose-500 p-6 my-6 rounded-r-xl">
					<h3 class="text-rose-900 font-bold mt-0 flex items-center gap-2">
						<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
						请停止使用百度搜索下载代理软件！
					</h3>
					<p class="text-rose-800 text-base mb-0">
						目前在百度搜“v2rayN下载”，排在前 5 页的所谓“中文官网”全部是假的！这些流氓网站会在原本只有 50MB 的安装包里塞入多达 200MB 的静默安装广告、锁定主页的流氓卫士，甚至直接植入键盘记录器。<br/><br/>
						<strong>v2rayN 是一个免费开源的软件，它的唯一官方发布渠道只有 GitHub！</strong>
					</p>
				</div>

				<h2>官方纯净版安全下载通道</h2>
