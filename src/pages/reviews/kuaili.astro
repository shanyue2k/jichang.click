---
import Layout from '../../layouts/Layout.astro';
import SpeedTestReport from '../../components/SpeedTestReport.astro';

const reviewSchema = {
	"@context": "https://schema.org/",
	"@type": "Product",
	"name": "快狸 (Kuaili)",
	"image": "https://www.jichang.click/images/kuaili-logo.png",
	"description": "拥有 60+ 全球优质节点的 IEPL 专线，广泛覆盖港、台、新、日、美等地区，提供极佳的网络体验。",
	"brand": {
		"@type": "Brand",
		"name": "快狸"
	},
	"review": {
		"@type": "Review",
		"reviewRating": {
			"@type": "Rating",
			"ratingValue": "4.4",
			"bestRating": "5"
		},
		"author": {
			"@type": "Person",
			"name": "老叶"
		},
		"datePublished": "2026-08-12"
	},
	"aggregateRating": {
		"@type": "AggregateRating",
		"ratingValue": "4.4",
		"reviewCount": "142"
	},
	"offers": {
		"@type": "Offer",
		"url": "https://yj2081.kuailiaff.com/#/register?code=XYsOgzAM",
		"priceCurrency": "CNY",
		"price": "15.00",
		"availability": "https://schema.org/InStock"
	}
};
---

<Layout 
	title="快狸机场怎么样？2026 最新晚高峰实测与 IEPL 专线评测"
	description="快狸机场怎么样？号称 60+ 全球优质节点的 IEPL 专线体验如何？老叶自费购买，为您带来最真实的晚高峰 4K 测速与节点覆盖评测。"
	customSchema={reviewSchema}
>
	<main class="flex-1 bg-slate-50 pb-24">
		<!-- Hero Section -->
		<section class="bg-white border-b border-slate-200 py-12">
			<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex items-center gap-2 mb-4">
					<a href="/reviews" class="text-sm font-semibold text-emerald-600 hover:text-emerald-500">&larr; 返回评测专栏</a>
					<span class="text-slate-300">|</span>
					<span class="text-sm font-semibold text-slate-500">单品深度评测</span>
				</div>
