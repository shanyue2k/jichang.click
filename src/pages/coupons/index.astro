					<div class="relative z-10 flex items-center justify-center gap-4 mt-4">
						<code class="copy-target cursor-pointer px-6 py-3 bg-white/20 backdrop-blur-md rounded-2xl text-4xl font-mono font-bold text-white border border-white/30 tracking-wider select-all shadow-inner hover:bg-white/30 transition-colors" data-code="firefly" title="点击复制">
