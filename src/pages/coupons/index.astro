					</div>
				</div>
			</div>

			<!-- 核心优惠码卡片 4：Firefly -->
			<div class="rounded-3xl bg-white shadow-xl shadow-slate-200/50 ring-1 ring-slate-900/5 overflow-hidden mb-12 relative">
				<div class="absolute top-0 right-0 rounded-bl-3xl bg-rose-500 px-4 py-1 text-xs font-bold text-white shadow-md z-20">高性价比</div>
				<div class="bg-gradient-to-br from-rose-500 to-red-600 p-8 text-center relative overflow-hidden">
					<div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-20"></div>
