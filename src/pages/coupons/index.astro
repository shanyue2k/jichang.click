				</div>
				
				<div class="p-8 pb-10">
					<div class="text-center">
						<a href="https://wzjc.1flyunaff.cc/#/register?code=glcBWFxs" target="_blank" rel="nofollow sponsored" class="inline-flex items-center justify-center rounded-xl bg-slate-800 px-8 py-3.5 text-base font-bold text-white shadow-lg shadow-slate-500/30 hover:bg-slate-700 transition-all hover:-translate-y-0.5">
